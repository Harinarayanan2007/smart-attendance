{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "pnpm run build && node --import tsx --test \"src/**/*.test.ts\"",
    "test:unit": "pnpm run build && node --import tsx --test \"src/**/*.test.ts\"",
    "test:integration": "pnpm run build && node --import tsx --test src/app.integration.test.ts",
    "test:coverage": "pnpm run build && node --import tsx --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "verify": "pnpm run build && pnpm run test && pnpm run test:coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/database/seeds/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
