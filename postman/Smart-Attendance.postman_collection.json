                                "key": "Authorization",
                                "value": "Bearer {{ADMIN_TOKEN}}"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"name\": \"Computer Science Updated\"\n}"
                        },
                        "url": {
                            "raw": "{{BASE_URL}}/departments/{{DEPARTMENT_ID}}",
                            "host": [
                                "{{BASE_URL}}"
                            ],
                            "path": [
                                "departments",
                                "{{DEPARTMENT_ID}}"
                            ]
                        },
                        "description": "Updates a department. Admin only."
                    }
                }
            ]
        },
